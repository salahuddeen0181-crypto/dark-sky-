# Copy to deploy/.env on the server (never commit it). docker compose reads it for the variables in docker-compose.yml.
SITE_HOST=203-0-113-10.sslip.io        # server IP with dashes + .sslip.io, or your domain (its A record → the server)
DB_PASSWORD=                           # long random string
ADMIN_PASSWORD=
STAFF_PIN=                             # 6+ digits, the bar tablet
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                      # admin → Telegram → «Найти группу»
VENUE_TIMEZONE=America/Argentina/Buenos_Aires
