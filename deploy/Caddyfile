# Visitors come through Cloudflare: trust the client address it passes on (CF-Connecting-IP) only from
# Cloudflare's own ranges (https://www.cloudflare.com/ips), so the login lockouts count real visitors.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# https for SITE_HOST (the menu's domain); certificates are automatic
{$SITE_HOST} {
	encode zstd gzip
	@media path /media/*
	# fresh for an hour, then the browser shows its copy and fetches an updated clip in the background
	header @media >Cache-Control "public, max-age=3600, stale-while-revalidate=604800"
	# no request is bigger than a photo upload (≤1.5 MB)
	request_body {
		max_size 2MB
	}
	# the real visitor address for the login limits (client_ip: CF-Connecting-IP, see above); replaces any sent by the client
	reverse_proxy app:3000 {
		header_up X-Real-IP {client_ip}
	}
}

www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}

# the previous address (links and QR codes already handed out) → the domain
{$SITE_OLD} {
	redir https://{$SITE_HOST}{uri} permanent
}
