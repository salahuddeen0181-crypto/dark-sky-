# https for SITE_HOST (the menu's domain); certificates are automatic
{$SITE_HOST} {
	encode zstd gzip
	@media path /media/*
	# fresh for an hour, then the browser shows its copy and fetches an updated clip in the background
	header @media >Cache-Control "public, max-age=3600, stale-while-revalidate=604800"
	reverse_proxy app:3000
}

www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}

# the previous address (links and QR codes already handed out) → the domain
{$SITE_OLD} {
	redir https://{$SITE_HOST}{uri} permanent
}
