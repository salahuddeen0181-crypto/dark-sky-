# Copy to .env.local for local development; on Vercel add these in Project → Settings → Environment Variables.

# Supabase → Connect → "Transaction pooler" connection string (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Password for /admin
ADMIN_PASSWORD=

# PIN for the staff order page /staff (6+ digits; changing it logs every device out)
STAFF_PIN=

# @BotFather → /newbot → token
TELEGRAM_BOT_TOKEN=
# Staff group id: add the bot to the group and send /id there (looks like -100…)
TELEGRAM_CHAT_ID=

# Optional
# SITE_URL=https://menu.darksky.com     # final address used in QR codes (default: the address the admin is opened on)
# VENUE_TIMEZONE=America/Argentina/Buenos_Aires
